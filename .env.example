# GitHub API (server-side, optional but recommended)
GITHUB_TOKEN=

# Supabase Auth + Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Keep false/unset until the Supabase confirmation email template points to
# the RepoScope prefetch-safe confirmation page.
EMAIL_CONFIRMATION_FLOW_READY=false

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Display-only price label used on the pricing page.
NEXT_PUBLIC_PLAN_PRICE_LABEL=R$ 9,90/mês
